{
  "name": "keychain-store",
  "version": "1.0.0",
  "description": "Secure storage for signed Electron and Node apps, backed by the modern macOS Data Protection Keychain",
  "keywords": [
    "data-protection-keychain",
    "electron",
    "encryption",
    "keychain",
    "macos",
    "security"
  ],
  "homepage": "https://github.com/biw/keychain-store#readme",
  "bugs": {
    "url": "https://github.com/biw/keychain-store/issues"
  },
  "license": "MIT",
  "author": "Ben Williams",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biw/keychain-store.git"
  },
  "files": [
    "dist/"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:swift-package": "swift build",
    "format": "oxfmt --write . && xcrun swift-format format -i src/native.swift Tests/KeychainStoreTests/KeychainStoreTests.swift Package.swift",
    "format:check": "oxfmt --check . && xcrun swift-format lint --strict src/native.swift Tests/KeychainStoreTests/KeychainStoreTests.swift Package.swift",
    "lint": "oxlint --deny-warnings .",
    "precommit": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm test:swift",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test test/*.test.mjs test/*.test.ts",
    "test:integration": "pnpm build && node --test test/integration/**/*.test.mjs",
    "test:swift": "swift test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "swift-node": "0.3.0",
    "swift-node-unplugin": "0.3.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
